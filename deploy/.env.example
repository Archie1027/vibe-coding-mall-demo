# Copy project-specific values to .local/dev.env; never commit real credentials.
DB_URL=jdbc:mysql://127.0.0.1:3306/zhicai_dev?connectionTimeZone=UTC
DB_USERNAME=zhicai_app
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
PAYMENT_MODE=MOCK
CATALOG_WRITES_ENABLED=false
CUSTOMER_WRITES_ENABLED=false
ORDER_WRITES_ENABLED=false
CATALOG_UPLOAD_ROOT=
# Explicit 32-byte Base64 key; keep stable while encrypted replay records are unexpired.
CATALOG_REPLAY_KEY=
