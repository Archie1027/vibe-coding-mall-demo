<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
  <groupId>com.zhicai.platform</groupId><artifactId>zhicai-platform</artifactId><version>0.1.0-SNAPSHOT</version><packaging>pom</packaging>
  <properties><java.version>21</java.version><mybatis.version>3.0.5</mybatis.version></properties>
  <modules><module>platform-common</module><module>platform-identity</module><module>platform-catalog</module><module>platform-inventory</module><module>platform-trade</module><module>platform-app</module></modules>
  <dependencyManagement><dependencies>
    <dependency><groupId>org.mybatis.spring.boot</groupId><artifactId>mybatis-spring-boot-starter</artifactId><version>${mybatis.version}</version></dependency>
  </dependencies></dependencyManagement>
  <build><pluginManagement><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
    <configuration><tempDir>surefire</tempDir><forkCount>1</forkCount><reuseForks>true</reuseForks><argLine>-Xms32m -Xmx256m -Djava.io.tmpdir=${project.build.directory}</argLine></configuration>
  </plugin></plugins></pluginManagement></build>
</project>
