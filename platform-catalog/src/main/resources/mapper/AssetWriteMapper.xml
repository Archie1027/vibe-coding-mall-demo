<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhicai.platform.catalog.AssetWriteMapper">
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO asset(storage_key,content_type,size_bytes,visibility,owner_id) VALUES(#{storageKey},#{contentType},#{sizeBytes},'PUBLIC',CAST(#{ownerId} AS UNSIGNED))
  </insert>
  <select id="publicByKey" resultType="com.zhicai.platform.catalog.AssetWriteMapper$PublicAsset">
    SELECT CAST(id AS CHAR) id,storage_key storageKey,content_type contentType,size_bytes sizeBytes FROM asset WHERE storage_key=#{key} AND visibility='PUBLIC'
  </select>
</mapper>
